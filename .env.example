# Copy to .env.local for local development. On Vercel, set these in
# Project -> Settings -> Environment Variables (DATABASE_URL is added
# automatically by the Neon integration).

# Neon Postgres connection string
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Random 32+ byte secret for signing device cookies:  openssl rand -base64 32
SESSION_SECRET=

# Protects /api/cron/* (Vercel Cron sends it as a Bearer token) and the
# Python /api/py/* compute endpoints.
CRON_SECRET=

# Web Push (generate with:  npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Optional: override the Python service URL (defaults to http://127.0.0.1:8000 locally)
# PY_API_URL=
